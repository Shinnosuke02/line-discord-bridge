# Deprecated compatibility copy.
# Prefer .env.example for new deployments.
#
# LINE-Discord Bridge environment example
# Copy to .env and fill in actual values.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_BASE_URL=https://your-domain.example

# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_WEBHOOK_PATH=/webhook

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CATEGORY_FRIENDS=
DISCORD_CATEGORY_GROUPS=

# Bridge behavior
WEBHOOK_ENABLED=true
BRIDGE_REPLY_ENABLED=true
BRIDGE_REACTION_ENABLED=false
LINE_TO_DISCORD_REPLY_MODE=webhook
LINE_MARK_AS_READ_ON_DISCORD_DELIVERY=false

# Security / media
LINE_SIGNATURE_VALIDATION_ENABLED=true
TEMP_PATH=./temp
TEMP_STATIC_ENABLED=true
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
IMAGE_RESIZE_ENABLED=true
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080
IMAGE_QUALITY=80
VIDEO_COMPRESSION_ENABLED=false
VIDEO_MAX_SIZE=52428800

# Channel management
AUTO_CREATE_CHANNELS=true
CHANNEL_PREFIX=line-
MAX_CHANNELS=100

# Persistence
# Production Oracle VPS:
# DB_TYPE=sqlite
# DB_FILE=/var/lib/line-discord-bridge/bridge.sqlite3
# DB_BACKUP_PATH=/var/lib/line-discord-bridge/backups
#
# DB_TYPE=file is retained only for the legacy channel-mapping rollback path.
DB_TYPE=file
DB_PATH=./data
DB_FILE=./data/bridge.sqlite3
DB_BACKUP_PATH=./data/backups

# Optional request/security controls
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
CORS_ENABLED=true
CORS_ORIGINS=*

# Monitoring
METRICS_ENABLED=true
METRICS_PATH=/metrics
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health

# LINE usage alerts
LINE_ADMIN_USER_IDS=
