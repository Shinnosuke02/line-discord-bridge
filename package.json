{
  "name": "line-discord-bridge",
  "version": "3.2.0",
  "description": "Reliable LINE-Discord bridge with durable SQLite delivery, modern LINE SDK support, and bidirectional message lifecycle",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write src/",
    "migrate:json": "node scripts/migrate-json-to-sqlite.js",
    "db:status": "node scripts/db-status.js",
    "db:backup": "node scripts/backup-sqlite.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop line-discord-bridge",
    "pm2:restart": "pm2 restart line-discord-bridge",
    "pm2:logs": "pm2 logs line-discord-bridge",
    "pm2:status": "pm2 status",
    "pm2:delete": "pm2 delete line-discord-bridge"
  },
  "keywords": [
    "line",
    "discord",
    "bridge",
    "bot",
    "messaging",
    "api",
    "bidirectional",
    "reply",
    "webhook"
  ],
  "author": "Shinnosuke02",
  "license": "MIT",
  "dependencies": {
    "@line/bot-sdk": "^11.2.0",
    "axios": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "file-type": "^18.7.0",
    "helmet": "^7.1.0",
    "mime-types": "^2.1.35",
    "sharp": "^0.33.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "supertest": "^7.1.3"
  },
  "engines": {
    "node": ">=24.17.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shinnosuke02/line-discord-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Shinnosuke02/line-discord-bridge/issues"
  },
  "homepage": "https://github.com/Shinnosuke02/line-discord-bridge#readme"
}
